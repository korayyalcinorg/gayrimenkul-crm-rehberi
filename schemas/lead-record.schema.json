{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gayrimenkul Lead Kaydı",
  "type": "object",
  "required": ["lead_id", "telefon", "kaynak", "crm_asamasi"],
  "properties": {
    "lead_id": {"type": "string"},
    "ad_soyad": {"type": "string"},
    "telefon": {"type": "string"},
    "e_posta": {"type": "string", "format": "email"},
    "ulke": {"type": "string"},
    "sehir": {"type": "string"},
    "dil": {"type": "string"},
    "kaynak": {"type": "string"},
    "kampanya": {"type": "string"},
    "reklam_seti": {"type": "string"},
    "reklam": {"type": "string"},
    "utm_source": {"type": "string"},
    "utm_medium": {"type": "string"},
    "utm_campaign": {"type": "string"},
    "proje": {"type": "string"},
    "butce_min": {"type": "number"},
    "butce_max": {"type": "number"},
    "pesinat": {"type": "number"},
    "satin_alma_zamani": {"type": "string"},
    "yatirim_amaci": {"type": "string"},
    "atanan_temsilci": {"type": "string"},
    "crm_asamasi": {"type": "string"},
    "first_contact_at": {"type": "string", "format": "date-time"},
    "last_contact_at": {"type": "string", "format": "date-time"},
    "next_action_at": {"type": "string", "format": "date-time"},
    "nr_count": {"type": "integer", "minimum": 0},
    "lost_reason": {"type": "string"}
  }
}
